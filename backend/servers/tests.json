{
  "tests": [
    {
      "name": "Get all servers",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {
        "servers": "array"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Get server by ID",
      "method": "GET",
      "path": "/?id=1",
      "expectedStatus": 200,
      "expectedBody": {
        "id": 1,
        "name": "string",
        "status": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Toggle server status",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "toggle",
        "serverId": 1
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true,
        "serverId": 1
      },
      "bodyMatcher": "partial"
    }
  ]
}
